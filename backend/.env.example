# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_college_lost_and_found_project_2026
JWT_EXPIRES_IN=7d

# MySQL Database Configuration (AWS EC2 or Local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=lost_and_found_db

# Amazon S3 Configuration
# When deployed on AWS EC2 with IAM Role attached, leave ACCESS_KEY_ID and SECRET_ACCESS_KEY empty.
# For local testing with real S3, provide AWS credentials.
AWS_REGION=us-east-1
AWS_BUCKET_NAME=lost-and-found-uploads-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local storage fallback (true: stores files in /uploads locally when S3 is unavailable)
USE_LOCAL_STORAGE=true
